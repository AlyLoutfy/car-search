# --- Telegram (required to actually receive alerts) ---
# 1. Open Telegram, message @BotFather, send /newbot, follow prompts -> copy the token here.
# 2. Message your new bot once (say "hi"), then visit
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy the "chat":{"id":...} value.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=123456789

# --- Jina Reader (optional) ---
# The free tier works without a key. A key raises the rate limit. Get one at https://jina.ai/reader
JINA_API_KEY=

# --- Behaviour (optional) ---
# Set to 1 to print what WOULD be sent to Telegram without sending anything.
DRY_RUN=
